# Copy this file to .env and replace the placeholder values.
SECRET_KEY=replace-with-a-long-random-value
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kss

# Paystack hosted checkout. The secret key is used only by the server to
# initialize, verify, and authenticate webhook events; never expose it in HTML.
PAYSTACK_PUBLIC_KEY=pk_test_replace_me
PAYSTACK_SECRET_KEY=sk_test_replace_me

# Configure this exact public HTTPS URL in Paystack Dashboard > Webhooks.
# https://your-domain.example/payment/webhook

BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
